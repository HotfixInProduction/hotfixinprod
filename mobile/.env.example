# Google Maps API Keys

# Android: Enable "Maps SDK for Android"
GOOGLE_MAPS_ANDROID_API_KEY=your_android_api_key_here

# iOS: Enable "Maps SDK for iOS"
GOOGLE_MAPS_IOS_API_KEY=your_ios_api_key_here

# Google OAuth Client IDs (for Google Calendar integration)
# Get these from: https://console.cloud.google.com/apis/credentials
# 1. Enable the Google Calendar API
# 2. Create OAuth 2.0 Client IDs for Android, iOS, and Web
GOOGLE_OAUTH_CLIENT_ID_ANDROID=your_android_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_ID_IOS=your_ios_oauth_client_id_here
